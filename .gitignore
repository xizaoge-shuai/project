# Python 编译文件
*.pyc
__pycache__/
*.pyo
*.pyd

# 虚拟环境
venv/
env/
.python-version

# 数据文件（通常较大或含敏感信息，不提交）
*.json
*.jsonl
*.csv
*.tsv

# 模型检查点和输出
outputs/
checkpoints/
*.pkl
*.pt
*.bin

# 实验输出目录（所有实验生成的结果）
outputs/

# 日志
logs/
*.log

# 配置文件中的敏感信息（如 API keys）
.env
configs/local.yaml

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 临时文件
*.tmp
*.bak

# 操作系统生成文件
.DS_Store
Thumbs.db

# Jupyter 笔记本（如果不需要提交）
*.ipynb_checkpoints/
*.ipynb

# 如果你确定要提交某些 shell 脚本，不要忽略 *.sh
# 但如果有些脚本是运行时自动生成的，可以单独忽略它们
# 例如：
# scripts/temp_*.sh
# Supplement release: generated data and artifacts
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
data/processed/
data/raw/
models/
wandb/
*.pth
