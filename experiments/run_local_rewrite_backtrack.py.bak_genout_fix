# =========================
# IO
# =========================


def read_jsonl(path: str) -> List[Dict[str, Any]]:
    with open(path, "r", encoding="utf-8") as f:
        rows: List[Dict[str, Any]] = []
        for line in f:
            line = line.strip()
            if line:
                rows.append(json.loads(line))
        return rows


def write_json(path: str, obj: Dict[str, Any]) -> None:
    out = Path(path)
    out.parent.mkdir(parents=True, exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)


def write_jsonl(path: str, rows: List[Dict[str, Any]]) -> None:
    out = Path(path)
    out.parent.mkdir(parents=True, exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


# =========================
# Generator
# =========================


def load_yaml(path: str) -> Dict[str, Any]:
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def build_generator(generator_config_path: str):
    cfg = load_yaml(generator_config_path)

    # 一个很稳的区分方式：
    # - 有 provider/base_url 的，多半是 API
    # - 否则按本地 generator 走
    if "provider" in cfg or "base_url" in cfg:
        return APIGenerator(cfg)
    return LocalGenerator(cfg)


def generate_repair_text(
    generator,
    prompt: str,
    max_new_tokens: int = 96,
) -> Dict[str, Any]:
    result = generator.generate_one(
        prompt,
        max_new_tokens=max_new_tokens,
    )
    if not isinstance(result, dict):
        return {
            "text": str(result),
            "tokens": None,
            "latency": None,
            "raw": result,
        }
    return {
        "text": result.get("text", ""),
        "tokens": result.get("tokens", None),
        "latency": result.get("latency", None),
        "raw": result,
    }


# =========================
# Text helpers
# =========================


def approx_token_count(text: str) -> int:
    if not text:
        return 0
    # 很粗略，但比空着强，适合做 repair 开销近似
    return len(re.findall(r"\w+|[^\w\s]", text, flags=re.UNICODE))


def safe_float(x: Any, default: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return default


def safe_int(x: Any, default: int = 0) -> int:
    try:
        return int(x)
    except Exception:
        return default


def get_bool_flag(row: Dict[str, Any], keys: List[str], default: bool = False) -> bool:
    for k in keys:
        if k in row:
            v = row[k]
            if isinstance(v, bool):
                return v
            if isinstance(v, (int, float)):
                return bool(v)
            if isinstance(v, str):
                vv = v.strip().lower()
                if vv in {"1", "true", "yes"}:
                    return True
                if vv in {"0", "false", "no"}:
                    return False
    return default


def get_first_nonempty(row: Dict[str, Any], keys: List[str], default: str = "") -> str:
    for k in keys:
        v = row.get(k, None)
        if v is not None and str(v).strip():
            return str(v)
    return default


def extract_last_int(text: str) -> int:
    nums = re.findall(r"(\d+)", text or "")
    if not nums:
        return 10**9
    return int(nums[-1])


def split_units(prefix_text: str) -> List[str]:
    """
    第一版：按非空行切分。
    这和你当前 atom/step 文本保存方式最兼容。
    """
    if not prefix_text:
        return []
    return [x.strip() for x in prefix_text.split("\n") if x.strip()]


def join_units(units: List[str]) -> str:
    return "\n".join([u for u in units if u.strip()])


def split_for_local_rewrite(
    prefix_text: str, rewrite_window: int = 1
) -> Tuple[str, str]:
    """
    把最后 rewrite_window 个 unit 作为 faulty_suffix，其余作为 valid_prefix。
    """
    units = split_units(prefix_text)
    if not units:
        return "", ""
    rewrite_window = max(1, int(rewrite_window))
    if rewrite_window >= len(units):
        return "", join_units(units)
    valid_prefix = join_units(units[:-rewrite_window])
    faulty_suffix = join_units(units[-rewrite_window:])
    return valid_prefix, faulty_suffix


def build_local_rewrite_prompt(
    question: str,
    valid_prefix: str,
    faulty_suffix: str,
    current_answer: str,
    error_type: str = "unknown_error",
    task: str = "gsm8k",
    context: str = "",
) -> str:
    context_block = f"Context:\n{context}\n\n" if context.strip() else ""

    task_hint = ""
    if task == "gsm8k":
        task_hint = (
            "This is a math reasoning problem. "
            "Be conservative. "
            "Only rewrite if there is a clear local error. "
            "Otherwise keep the suffix unchanged. "
            "End with 'Final Answer: <number>'."
        )
    else:
        task_hint = (
            "Be conservative. "
            "Only rewrite if there is a clear local error. "
            "Otherwise keep the suffix unchanged. "
            "End with 'Final Answer: <answer>'."
        )

    return f"""You are revising a reasoning trace.

{task_hint}

Rules:
1. Keep the valid prefix unchanged.
2. Do NOT restart the whole solution.
3. If there is NO clear local error in the suspicious suffix, output KEEP.
4. Only output REWRITE if there is a clear local error.
5. Make the minimal edit necessary.
6. Do NOT change the final answer unless clearly necessary.
7. Do NOT output any explanation before the decision tag.
8. The FIRST LINE must be exactly one of:
[KEEP]
or
[REWRITE]

Output format:
[KEEP]
<the original suffix followed by continuation if needed>

or

[REWRITE]
<corrected suffix and continuation>

The final line must still be:
Final Answer: <answer>

Question:
{question}

{context_block}Valid prefix:
{valid_prefix if valid_prefix.strip() else "[EMPTY]"}

Suspicious suffix:
{faulty_suffix if faulty_suffix.strip() else "[EMPTY]"}

Current answer:
{current_answer if str(current_answer).strip() else "[UNKNOWN]"}

Error type hint:
{error_type}
"""


# =========================
# Parsing / Answer checking
# =========================

FINAL_PATTERNS = [
    r"Final Answer\s*:\s*(.+)",
    r"Answer\s*:\s*(.+)",
    r"The answer is\s+(.+)",
]


def fallback_extract_final_answer(text: str) -> str:
    text = (text or "").strip()
    for pat in FINAL_PATTERNS:
        m = re.search(pat, text, flags=re.IGNORECASE | re.DOTALL)
        if m:
            return m.group(1).strip().split("\n")[0].strip()
    lines = [x.strip() for x in text.split("\n") if x.strip()]
    return lines[-1] if lines else ""


def parse_generation_output(text: str, task: str = "gsm8k") -> Dict[str, Any]:
    if project_parse_generation_output is not None:
        try:
            return project_parse_generation_output(text=text, task=task)
        except Exception:
            pass

    final_answer = fallback_extract_final_answer(text)
    steps = [x.strip() for x in text.split("\n") if x.strip()]
    return {
        "text": text,
        "steps": steps,
        "final_answer": final_answer,
    }


def normalize_number_string(s: str) -> str:
    s = (s or "").strip()
    s = s.replace(",", "")
    s = s.replace("$", "")
    s = s.replace("€", "")
    s = s.replace("£", "")
    s = s.strip().rstrip(".")
    return s


def extract_numeric_answer(text: str) -> Optional[str]:
    text = normalize_number_string(text)
    nums = re.findall(r"-?\d+(?:\.\d+)?", text)
    if not nums:
        return None
    return nums[-1]


def normalize_generic_answer(s: str) -> str:
    s = (s or "").strip().lower()
    s = re.sub(r"\s+", " ", s)
    s = s.strip(" .,:;!?\"'`()[]{}")
    return s


def is_answer_correct(
    pred_answer: str, gold_answer: str, dataset: str = "gsm8k"
) -> bool:
    if dataset == "gsm8k":
        p = extract_numeric_answer(pred_answer)
        g = extract_numeric_answer(gold_answer)
        if p is None or g is None:
            return False
        return normalize_number_string(p) == normalize_number_string(g)

    return normalize_generic_answer(pred_answer) == normalize_generic_answer(
        gold_answer
    )


# =========================
# Trigger selection
# =========================


def sort_prediction_rows(rows: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    def key_fn(r: Dict[str, Any]):
        if "prefix_index" in r:
            return safe_int(r["prefix_index"], 10**9)
        if "prefix_progress" in r:
            return safe_float(r["prefix_progress"], 10**9)
        return extract_last_int(get_first_nonempty(r, ["prefix_id"], ""))

    return sorted(rows, key=key_fn)


def choose_first_trigger_row(
    rows: List[Dict[str, Any]],
    tau_trigger: float,
    require_repairable: bool = True,
    missing_repairable_policy: str = "allow",
    repair_prob_threshold: float = 0.5,
    min_trigger_progress: float = 0.0,
) -> Optional[Dict[str, Any]]:
    rows = sort_prediction_rows(rows)
    for r in rows:
        prob = safe_float(r.get("success_prob", r.get("score", 1.0)), 1.0)
        # Prefer continuous repair probability so --repair_prob_threshold really works.
        # The binary "repairable" field may have been precomputed with another threshold.
        if "repair_prob" in r:
            repairable = int(safe_float(r.get("repair_prob", 0.0), 0.0) >= repair_prob_threshold)
        elif "repairable_prob" in r:
            repairable = int(safe_float(r.get("repairable_prob", 0.0), 0.0) >= repair_prob_threshold)
        elif "repairable" in r:
            repairable = safe_int(r.get("repairable", 0), 0)
        else:
            if not require_repairable:
                repairable = 1
            elif missing_repairable_policy == "allow":
                repairable = 1
            elif missing_repairable_policy == "block":
                repairable = 0
            elif missing_repairable_policy == "error":
                raise ValueError(
                    "require_repairable=1 but prediction row has no "
                    "repairable/repair_prob/repairable_prob field. "
                    "Use --require_repairable 0 for success-only experiments."
                )
            else:
                raise ValueError(f"Unknown missing_repairable_policy={missing_repairable_policy}")
        progress = safe_float(r.get("prefix_progress", 1.0), 1.0)

        if progress < min_trigger_progress:
            continue

        if prob < tau_trigger:
            if require_repairable and repairable != 1:
                continue
            return r
    return None


# =========================
# Main
# =========================


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--predictions", required=True, help="prefix-level predictions jsonl"
    )
    parser.add_argument("--trajectories", required=True, help="trajectory bank jsonl")
    parser.add_argument("--generator_config", required=True)
    parser.add_argument(
        "--dataset", default="gsm8k", choices=["gsm8k", "strategyqa", "hotpotqa"]
    )
    parser.add_argument("--tau_trigger", type=float, default=0.48)
    parser.add_argument("--rewrite_window", type=int, default=1)
    parser.add_argument("--max_new_tokens", type=int, default=96)
    parser.add_argument("--require_repairable", type=int, default=1)
    parser.add_argument("--missing_repairable_policy", choices=["allow", "block", "error"], default="allow")
    parser.add_argument("--repair_prob_threshold", type=float, default=0.5)
    parser.add_argument("--max_cases", type=int, default=-1, help="debug only")
    parser.add_argument("--out_json", required=True)
    parser.add_argument("--out_jsonl", required=True)
    parser.add_argument("--min_trigger_progress", type=float, default=0.0)
    args = parser.parse_args()

    pred_rows = read_jsonl(args.predictions)
    traj_rows = read_jsonl(args.trajectories)

    # trajectory map
    traj_by_id: Dict[str, Dict[str, Any]] = {}
    for t in traj_rows:
        tid = get_first_nonempty(t, ["trajectory_id"], "")
        if tid:
            traj_by_id[tid] = t

    # group predictions by trajectory
    preds_by_traj: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for r in pred_rows:
        tid = get_first_nonempty(r, ["trajectory_id"], "")
        if tid:
            preds_by_traj[tid].append(r)

    generator = build_generator(args.generator_config)

    details: List[Dict[str, Any]] = []

    n_total_trajectories = 0
    n_bad_trajectories = 0
    n_good_trajectories = 0

    num_triggered = 0
    num_rewritten = 0
    num_recovered = 0
    num_recovered_bad = 0
    num_preserved_good = 0
    num_harmed_good = 0

    sum_extra_tokens = 0.0
    sum_extra_tokens_triggered = 0.0
    sum_trigger_progress = 0.0

    processed_cases = 0

    for trajectory_id, rows in preds_by_traj.items():
        if args.max_cases > 0 and processed_cases >= args.max_cases:
            break

        traj = traj_by_id.get(trajectory_id, {})
        orig_gold = get_first_nonempty(traj, ["gold_answer", "answer"], "")
        orig_final = get_first_nonempty(traj, ["final_answer"], "")

        if any(k in traj for k in ["is_correct", "label_success", "correct"]):
            original_is_correct = get_bool_flag(
                traj,
                ["is_correct", "label_success", "correct"],
                default=False,
            )
        elif orig_final.strip() and orig_gold.strip():
            original_is_correct = is_answer_correct(
                pred_answer=orig_final,
                gold_answer=orig_gold,
                dataset=args.dataset,
            )
        else:
            last_row = sort_prediction_rows(rows)[-1]
            original_is_correct = get_bool_flag(
                last_row,
                ["is_correct", "label_success", "correct", "trajectory_is_correct"],
                default=False,
            )

        n_total_trajectories += 1
        if original_is_correct:
            n_good_trajectories += 1
        else:
            n_bad_trajectories += 1

        trigger_row = choose_first_trigger_row(
            rows=rows,
            tau_trigger=args.tau_trigger,
            require_repairable=bool(args.require_repairable),
            missing_repairable_policy=args.missing_repairable_policy,
            repair_prob_threshold=args.repair_prob_threshold,
            min_trigger_progress=args.min_trigger_progress,
        )

        if trigger_row is None:
            details.append(
                {
                    "trajectory_id": trajectory_id,
                    "sample_id": get_first_nonempty(traj, ["sample_id", "id"], ""),
                    "triggered": False,
                    "original_is_correct": original_is_correct,
                    "recovered": False,
                    "preserved_good": False,
                    "harmed_good": False,
                    "trigger_prob": None,
                    "trigger_progress": None,
                    "repair_prompt": None,
                    "repair_output": None,
                    "repaired_final_answer": None,
                    "gold_answer": get_first_nonempty(
                        traj, ["gold_answer", "answer"], ""
                    ),
                    "extra_repair_tokens": 0,
                }
            )
            processed_cases += 1
            continue

        num_triggered += 1

        question = get_first_nonempty(
            trigger_row, ["question"], get_first_nonempty(traj, ["question"], "")
        )
        context = get_first_nonempty(
            trigger_row, ["context"], get_first_nonempty(traj, ["context"], "")
        )
        prefix_text = get_first_nonempty(trigger_row, ["prefix_text"], "")
        current_answer = get_first_nonempty(
            trigger_row,
            ["current_answer", "final_answer"],
            get_first_nonempty(traj, ["final_answer"], ""),
        )
        error_type = get_first_nonempty(trigger_row, ["error_type"], "unknown_error")
        gold_answer = get_first_nonempty(traj, ["gold_answer", "answer"], "")
        trigger_prob = safe_float(trigger_row.get("success_prob", 1.0), 1.0)
        trigger_progress = safe_float(trigger_row.get("prefix_progress", 0.0), 0.0)

        sum_trigger_progress += trigger_progress

        # =========================
        # Safe local rewrite v3
        # =========================
        #
        # Old behavior:
        #   split prefix_text -> valid_prefix/faulty_suffix.
        #   If prefix_text is empty, both become [EMPTY], but the script still calls the repairer.
        #
        # New behavior:
        #   use the original trajectory steps and trigger_progress to build a non-empty local window.
        #   if local context is invalid, force KEEP.
        #   if repair output is malformed, force KEEP.
        #   KEEP must preserve the original correctness label.
        steps_for_repair = traj.get("steps", [])
        if not isinstance(steps_for_repair, list):
            steps_for_repair = []

        valid_prefix_steps, faulty_suffix_steps, trigger_idx = split_steps_for_repair(
            steps=steps_for_repair,
            trigger_progress=trigger_progress,
            rewrite_window=args.rewrite_window,
        )

        valid_prefix = "\n".join(str(x).strip() for x in valid_prefix_steps if str(x).strip())
        faulty_suffix = "\n".join(str(x).strip() for x in faulty_suffix_steps if str(x).strip())

        if not str(current_answer).strip():
            # fallback: extract from the full original trajectory if current_answer is missing
            current_answer = fallback_extract_final_answer("\n".join(str(x) for x in steps_for_repair))

        repair_prompt = build_safe_repair_prompt(
            question=question,
            valid_prefix_steps=valid_prefix_steps,
            suspicious_suffix_steps=faulty_suffix_steps,
            current_answer=current_answer,
            error_type_hint=error_type,
        )

        repair_text = ""
        cleaned_repair_text = ""
        repaired_full_text = ""
        repaired_final_answer = str(current_answer or "").strip()
        extra_tokens = 0
        decision = "KEEP"
        safe_reason = "empty_local_context"

        if repair_prompt is None:
            # No valid local context. Do not call the repairer.
            decision = "KEEP"
            safe_reason = "empty_local_context"
            repaired_final_answer = str(current_answer or "").strip()
            repaired_full_text = (
                valid_prefix + "\n" + faulty_suffix
                if valid_prefix.strip()
                else faulty_suffix
            )
            repaired_is_correct = bool(original_is_correct)

        else:
            gen_out = generate_repair_text(
                generator=generator,
                prompt=repair_prompt,
                max_new_tokens=args.max_new_tokens,
            )
            repair_text = (gen_out.get("text", "") or "").strip()
            repair_text = truncate_generation_noise(repair_text)

            extra_tokens = gen_out.get("tokens", None)
            if extra_tokens is None:
                extra_tokens = approx_token_count(repair_text)

            sum_extra_tokens += float(extra_tokens)
            sum_extra_tokens_triggered += float(extra_tokens)

            gate = safe_repair_gate(
                repair_output=repair_text,
                original_answer=str(current_answer or "").strip(),
            )

            decision = gate.get("action", "KEEP")
            safe_reason = gate.get("reason", "")
            cleaned_repair_text = gate.get("cleaned_output", repair_text)

            if decision == "REWRITE":
                num_rewritten += 1
                repaired_final_answer = str(gate.get("final_answer", "")).strip()
                repaired_full_text = (
                    valid_prefix + "\n" + cleaned_repair_text
                    if valid_prefix.strip()
                    else cleaned_repair_text
                )
                repaired_is_correct = is_answer_correct(
                    pred_answer=repaired_final_answer,
                    gold_answer=gold_answer,
                    dataset=args.dataset,
                )
            else:
                # Invalid repair output. Keep original trajectory.
                repaired_final_answer = str(current_answer or "").strip()
                repaired_full_text = (
                    valid_prefix + "\n" + faulty_suffix
                    if valid_prefix.strip()
                    else faulty_suffix
                )
                repaired_is_correct = bool(original_is_correct)

        recovered = False
        preserved_good = False
        harmed_good = False

        if original_is_correct:
            if repaired_is_correct:
                num_preserved_good += 1
                preserved_good = True
            else:
                num_harmed_good += 1
                harmed_good = True
        else:
            if repaired_is_correct:
                num_recovered += 1
                num_recovered_bad += 1
                recovered = True

        details.append(
            {
                "trajectory_id": trajectory_id,
                "sample_id": get_first_nonempty(traj, ["sample_id", "id"], ""),
                "triggered": True,
                "original_is_correct": original_is_correct,
                "recovered": recovered,
                "preserved_good": preserved_good,
                "harmed_good": harmed_good,
                "trigger_prob": trigger_prob,
                "trigger_progress": trigger_progress,
                "error_type": error_type,
                "prefix_text": prefix_text,
                "valid_prefix": valid_prefix,
                "faulty_suffix": faulty_suffix,
                "repair_prompt": repair_prompt,
                "repair_output": repair_text,
                "repaired_full_text": repaired_full_text,
                "repaired_final_answer": repaired_final_answer,
                "gold_answer": gold_answer,
                "extra_repair_tokens": extra_tokens,
                "generator_latency": (gen_out.get("latency", None) if isinstance(gen_out, dict) else None),
                "repair_decision": decision,
                "safe_reason": safe_reason,
                "trigger_idx": trigger_idx,
                "cleaned_repair_output": cleaned_repair_text,
            }
        )

        processed_cases += 1
    num_triggered_bad = sum(
        1
        for d in details
        if d.get("triggered", False) and (not d.get("original_is_correct", False))
    )

    num_triggered_good = sum(
        1
        for d in details
        if d.get("triggered", False) and d.get("original_is_correct", False)
    )
    summary = {
        "setting": f"local_rewrite_backtrack/{args.dataset}",
        "tau_trigger": args.tau_trigger,
        "rewrite_window": args.rewrite_window,
        "max_new_tokens": args.max_new_tokens,
        "n_total_trajectories": n_total_trajectories,
        "n_bad_trajectories": n_bad_trajectories,
        "n_good_trajectories": n_good_trajectories,
        "num_triggered": num_triggered,
        "trigger_rate": (
            num_triggered / n_total_trajectories if n_total_trajectories > 0 else None
        ),
        "num_rewritten": num_rewritten,
        "num_recovered": num_recovered,
        "num_recovered_bad": num_recovered_bad,
        "num_preserved_good": num_preserved_good,
        "num_harmed_good": num_harmed_good,
        "recover_rate_all": (
            num_recovered / num_triggered if num_triggered > 0 else None
        ),
        "recover_rate_bad": (
            num_recovered_bad / num_triggered_bad if num_triggered_bad > 0 else None
        ),
        "preserve_rate_good": (
            num_preserved_good / num_triggered_good if num_triggered_good > 0 else None
        ),
        "harm_rate_good": (
            num_harmed_good / num_triggered_good if num_triggered_good > 0 else None
        ),
        "avg_trigger_progress": (
            sum_trigger_progress / num_triggered if num_triggered > 0 else None
        ),
        "avg_extra_repair_tokens_triggered": (
            sum_extra_tokens_triggered / num_triggered if num_triggered > 0 else None
        ),
        "avg_extra_repair_tokens_all": (
            sum_extra_tokens / n_total_trajectories
            if n_total_trajectories > 0
            else None
        ),
        "notes": (
            "This is a true generator-in-the-loop local-rewrite backtrack evaluator. "
            "It rewrites the suspicious local suffix instead of replaying the original future prefix."
        ),
    }

    print(json.dumps(summary, ensure_ascii=False, indent=2))
    write_json(args.out_json, summary)
    write_jsonl(args.out_jsonl, details)


if __name__ == "__main__":
    main()
