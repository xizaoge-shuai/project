def read_jsonl(path: str) -> List[Dict[str, Any]]:
    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(path)
    return [json.loads(x) for x in p.open("r", encoding="utf-8") if x.strip()]


def write_json(path: str, obj: Dict[str, Any]) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)


def append_jsonl(path: str, rows: List[Dict[str, Any]]) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("a", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def norm_num(x: Any) -> str:
    x = str(x or "").replace(",", "").replace("$", "")
    nums = re.findall(r"[-+]?\d+(?:\.\d+)?", x)
    if not nums:
        return str(x).strip()
    v = nums[-1]
    if "." in v:
        v = v.rstrip("0").rstrip(".")
    return v


def extract_answer(text: str) -> str:
    text = str(text or "").strip()

    patterns = [
        r"Final Answer\s*:\s*([^\n\r]+)",
        r"####\s*([^\n\r]+)",
        r"Answer\s*:\s*([^\n\r]+)",
        r"The answer is\s+([^\n\r\.]+)",
    ]

    for pat in patterns:
        m = re.search(pat, text, flags=re.I)
        if m:
            return norm_num(m.group(1))

    nums = re.findall(r"[-+]?\d+(?:\.\d+)?", text.replace(",", ""))
    return norm_num(nums[-1]) if nums else ""


def extract_answer_from_steps(steps: List[str]) -> str:
    joined = "\n".join(str(x) for x in (steps or []))
    return extract_answer(joined)


def traj_order(tid: str) -> int:
    m = re.search(r"_traj_(\d+)$", str(tid))
    return int(m.group(1)) if m else 999999


def normalize_generation_output(out: Any) -> str:
    if out is None:
        return ""
    if isinstance(out, str):
        return out
    if isinstance(out, dict):
        for k in ["text", "output", "response", "generated_text"]:
            if k in out:
                return str(out[k])
        return str(out)
    if isinstance(out, list):
        if not out:
            return ""
        return normalize_generation_output(out[0])
    if hasattr(out, "outputs"):
        outs = getattr(out, "outputs")
        if outs:
            first = outs[0]
            if hasattr(first, "text"):
                return str(first.text)
            return str(first)
    if hasattr(out, "text"):
        return str(getattr(out, "text"))
    return str(out)


def call_generator(generator: Any, prompt: str, max_new_tokens: int) -> str:
    for name in ["generate_one", "generate_text", "complete", "generate", "chat"]:
        if hasattr(generator, name):
            fn = getattr(generator, name)
            for call in [
                lambda: fn(prompt=prompt, max_new_tokens=max_new_tokens),
                lambda: fn(prompt=prompt),
                lambda: fn(prompt, max_new_tokens=max_new_tokens),
                lambda: fn(prompt),
            ]:
                try:
                    return normalize_generation_output(call())
                except TypeError:
                    continue

    for name in ["generate_many", "generate_batch", "batch_generate"]:
        if hasattr(generator, name):
            fn = getattr(generator, name)
            for call in [
                lambda: fn(prompts=[prompt], max_new_tokens=max_new_tokens),
                lambda: fn(prompts=[prompt]),
                lambda: fn([prompt], max_new_tokens=max_new_tokens),
                lambda: fn([prompt]),
            ]:
                try:
                    return normalize_generation_output(call())
                except TypeError:
                    continue

    raise AttributeError(
        "Unsupported generator object. Available public methods: "
        + str([x for x in dir(generator) if not x.startswith("_")])
    )


def build_resample_prompt(question: str, temperature_hint: str = "diverse") -> str:
    return f"""Solve the following grade-school math problem carefully.

Use a different reasoning path if possible. Check all arithmetic.
Do not copy previous solutions. Think step by step.

The final line must be exactly:
Final Answer: <number>

Question:
{question}
"""


def _short_text(x: Any, max_chars: int = 420) -> str:
    s = str(x or "").strip()
    s = re.sub(r"\s+", " ", s)
    if len(s) <= max_chars:
        return s
    return s[:120] + " ... " + s[-(max_chars - 125):]


def build_judge_prompt(question: str, candidates: List[Dict[str, Any]]) -> str:
    """
    Short judge prompt for vLLM max_model_len=2048.
    We intentionally avoid dumping full reasoning traces.
    """
    labels = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    lines = []
    lines.append("You are a strict math answer arbitrator.")
    lines.append("Choose the most reliable final answer from the candidate answers.")
    lines.append("Do not invent a new answer. The final answer must be one of the listed candidate final answers.")
    lines.append("Use reasoning snippets only as evidence. Prefer arithmetic consistency over confidence.")
    lines.append("")
    lines.append("Question:")
    lines.append(_short_text(question, 650))
    lines.append("")
    lines.append("Candidates:")

    for i, c in enumerate(candidates):
        label = labels[i]
        reasoning_tail = _short_text(c.get("text", ""), 320)
        lines.append("")
        lines.append(f"Candidate {label}:")
        lines.append(f"Source: {c.get('source', '')}")
        lines.append(f"Final answer: {c.get('answer', '')}")
        if c.get("source") == "original":
            lines.append(f"PCE tail5 score: {float(c.get('score', 0.0)):.4f}")
        else:
            lines.append("PCE tail5 score: N/A")
        lines.append(f"Reasoning snippet: {reasoning_tail if reasoning_tail else '(empty)'}")

    lines.append("")
    lines.append("Return exactly:")
    lines.append("Chosen Candidate: <A/B/C/D/E/F>")
    lines.append("Final Answer: <copy one candidate final answer>")
    lines.append("Reason Type: <arithmetic_error | missing_condition | unit_conversion | inconsistent_reasoning | majority_supported | confidence_supported | unknown>")
    return "\n".join(lines)


def parse_judge_output(text: str) -> Dict[str, str]:
    chosen = ""
    final = ""
    reason = ""

    m = re.search(r"Chosen Candidate\s*:\s*([A-Z])", text, flags=re.I)
    if m:
        chosen = m.group(1).upper()

    m = re.search(r"Final Answer\s*:\s*([^\n\r]+)", text, flags=re.I)
    if m:
        final = norm_num(m.group(1))

    m = re.search(r"Reason Type\s*:\s*([^\n\r]+)", text, flags=re.I)
    if m:
        reason = m.group(1).strip()

    return {"chosen": chosen, "final": final, "reason": reason}


def tail5_score(scores_by_tid: Dict[str, List[Tuple[int, float]]], tid: str) -> float:
    vals = [p for _, p in sorted(scores_by_tid.get(tid, []))]
    if not vals:
        return 1.0
    return sum(vals[-5:]) / min(5, len(vals))


def weighted_vote(cands: List[Dict[str, Any]]) -> Tuple[str, float, float, List[Tuple[str, float]]]:
    w = defaultdict(float)
    for c in cands:
        ans = c.get("answer", "")
        if not str(ans).strip():
            continue
        w[ans] += float(c.get("score", 1.0))

    if not w:
        return "", 0.0, 0.0, []

    ranked = sorted(w.items(), key=lambda x: x[1], reverse=True)
    top_ans, top_score = ranked[0]
    second = ranked[1][1] if len(ranked) > 1 else 0.0
    total = sum(w.values()) or 1.0
    return top_ans, top_score - second, (top_score - second) / total, ranked


def should_trigger(cands: List[Dict[str, Any]], trigger: str, margin_threshold: float) -> bool:
    answers = [c["answer"] for c in cands]
    uniq = len(set(answers))
    weighted_ans, _, margin_norm, _ = weighted_vote(cands)
    majority_ans = Counter(answers).most_common(1)[0][0]

    if trigger == "all_disagree":
        return uniq == len(answers)
    if trigger == "has_disagreement":
        return uniq >= 2
    if trigger == "margin":
        return margin_norm <= margin_threshold
    if trigger == "all_disagree_or_margin":
        return uniq == len(answers) or margin_norm <= margin_threshold
    if trigger == "majority_diff_weighted":
        return majority_ans != weighted_ans

    raise ValueError(f"Unknown trigger: {trigger}")


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--predictions", required=True)
    ap.add_argument("--trajectories", required=True)
    ap.add_argument("--repair_jsonl", required=True)
    ap.add_argument("--current_judge_jsonl", default=None)
    ap.add_argument("--generator_config", required=True)
    ap.add_argument("--dataset", default="gsm8k")
    ap.add_argument("--trigger", default="all_disagree")
    ap.add_argument("--margin_threshold", type=float, default=0.30)
    ap.add_argument("--n_extra", type=int, default=2)
    ap.add_argument("--max_new_tokens", type=int, default=256)
    ap.add_argument("--max_samples", type=int, default=-1)
    ap.add_argument("--extra_weight_mode", choices=["avg_orig", "fixed"], default="avg_orig")
    ap.add_argument("--extra_weight", type=float, default=1.0)
    ap.add_argument("--use_judge", type=int, default=1)
    ap.add_argument("--out_jsonl", required=True)
    ap.add_argument("--out_json", required=True)
    args = ap.parse_args()

    answer_mode = "numeric" if args.dataset == "gsm8k" else "span"

    pred_rows = read_jsonl(args.predictions)
    traj_rows = read_jsonl(args.trajectories)
    repair_rows = read_jsonl(args.repair_jsonl)

    repair_by_tid = {r["trajectory_id"]: r for r in repair_rows}

    current_judge_by_sid = {}
    if args.current_judge_jsonl and Path(args.current_judge_jsonl).exists():
        for r in read_jsonl(args.current_judge_jsonl):
            current_judge_by_sid[r["sample_id"]] = r

    scores_by_tid = defaultdict(list)
    for r in pred_rows:
        if "success_prob" in r:
            scores_by_tid[r["trajectory_id"]].append(
                (int(r.get("prefix_num_units", 0)), float(r["success_prob"]))
            )

    by_sample = defaultdict(list)
    for tr in traj_rows:
        tid = tr["trajectory_id"]
        sid = tr["sample_id"]
        gold = str(tr["gold_answer"])
        before = extract_answer_from_steps(tr.get("steps", []))
        after = before

        rr = repair_by_tid.get(tid)
        if rr and rr.get("repair_decision") == "REWRITE" and str(rr.get("repaired_final_answer", "")).strip():
            after = norm_num(rr.get("repaired_final_answer"))

        score = tail5_score(scores_by_tid, tid)

        by_sample[sid].append({
            "source": "original",
            "tid": tid,
            "sample_id": sid,
            "question": tr.get("question", ""),
            "gold": gold,
            "answer": after,
            "score": score,
            "text": "\n".join(str(x) for x in tr.get("steps", [])),
            "ok": int(is_correct_prediction(after, gold, answer_mode=answer_mode)),
        })

    target_samples = []
    for sid, cands in by_sample.items():
        cands = sorted(cands, key=lambda x: traj_order(x["tid"]))
        if should_trigger(cands, args.trigger, args.margin_threshold):
            target_samples.append(sid)

    target_samples = sorted(target_samples)
    if args.max_samples > 0:
        target_samples = target_samples[:args.max_samples]

    existing = {}
    out_path = Path(args.out_jsonl)
    if out_path.exists():
        for r in read_jsonl(str(out_path)):
            existing[r["sample_id"]] = r

    print("target_samples:", len(target_samples))
    print("existing:", len(existing))

    generator = build_generator(args.generator_config)

    new_rows = []
    labels = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

    for idx, sid in enumerate(target_samples, 1):
        if sid in existing:
            continue

        orig_cands = sorted(by_sample[sid], key=lambda x: traj_order(x["tid"]))
        gold = orig_cands[0]["gold"]
        question = orig_cands[0]["question"]

        orig_weighted_ans, orig_margin_abs, orig_margin_norm, orig_ranked = weighted_vote(orig_cands)
        orig_any_ok = int(any(c["ok"] for c in orig_cands))
        orig_weighted_ok = int(is_correct_prediction(orig_weighted_ans, gold, answer_mode=answer_mode))

        # current best pipeline: existing selective judge result if available, otherwise weighted vote.
        if sid in current_judge_by_sid:
            cur_ans = norm_num(current_judge_by_sid[sid].get("final_answer", ""))
            current_best_source = "judge"
        else:
            cur_ans = orig_weighted_ans
            current_best_source = "weighted"
        current_best_ok = int(is_correct_prediction(cur_ans, gold, answer_mode=answer_mode))

        extra_cands = []
        for j in range(args.n_extra):
            prompt = build_resample_prompt(question)
            out_text = call_generator(generator, prompt, args.max_new_tokens)
            ans = extract_answer(out_text)

            if args.extra_weight_mode == "avg_orig":
                ew = sum(c["score"] for c in orig_cands) / max(1, len(orig_cands))
            else:
                ew = args.extra_weight

            extra_cands.append({
                "source": "extra",
                "tid": f"{sid}_extra_{j}",
                "sample_id": sid,
                "question": question,
                "gold": gold,
                "answer": ans,
                "score": ew,
                "text": out_text,
                "ok": int(is_correct_prediction(ans, gold, answer_mode=answer_mode)),
            })

        all_cands = orig_cands + extra_cands

        aug_any_ok = int(any(c["ok"] for c in all_cands))
        aug_weighted_ans, aug_margin_abs, aug_margin_norm, aug_ranked = weighted_vote(all_cands)
        aug_weighted_ok = int(is_correct_prediction(aug_weighted_ans, gold, answer_mode=answer_mode))

        judge_output = ""
        judge_final_ans = ""
        judge_reason = ""
        judge_accepted = False
        judge_ok = aug_weighted_ok

        if args.use_judge:
            judge_prompt = build_judge_prompt(question, all_cands)
            judge_output = call_generator(generator, judge_prompt, 96)
            parsed = parse_judge_output(judge_output)

            candidate_answers = {c["answer"] for c in all_cands if str(c["answer"]).strip()}
            if parsed["final"] in candidate_answers:
                judge_final_ans = parsed["final"]
                judge_accepted = True
            elif parsed["chosen"] in labels:
                k = labels.index(parsed["chosen"])
                if k < len(all_cands):
                    cand_ans = all_cands[k]["answer"]
                    if cand_ans in candidate_answers:
                        judge_final_ans = cand_ans
                        judge_accepted = True

            if not judge_accepted:
                judge_final_ans = aug_weighted_ans

            judge_reason = parsed["reason"]
            judge_ok = int(is_correct_prediction(judge_final_ans, gold, answer_mode=answer_mode))

        row = {
            "sample_id": sid,
            "gold_answer": gold,
            "trigger": args.trigger,
            "n_extra": args.n_extra,
            "current_best_source": current_best_source,
            "current_best_answer": cur_ans,
            "current_best_ok": current_best_ok,
            "orig_answers": [c["answer"] for c in orig_cands],
            "orig_scores": [c["score"] for c in orig_cands],
            "orig_any_ok": orig_any_ok,
            "orig_weighted_answer": orig_weighted_ans,
            "orig_weighted_ok": orig_weighted_ok,
            "orig_margin_norm": orig_margin_norm,
            "extra_answers": [c["answer"] for c in extra_cands],
            "extra_ok": [c["ok"] for c in extra_cands],
            "aug_any_ok": aug_any_ok,
            "aug_weighted_answer": aug_weighted_ans,
            "aug_weighted_ok": aug_weighted_ok,
            "aug_margin_norm": aug_margin_norm,
            "judge_output": judge_output,
            "judge_final_answer": judge_final_ans,
            "judge_reason": judge_reason,
            "judge_accepted": judge_accepted,
            "judge_ok": judge_ok,
        }

        new_rows.append(row)

        if len(new_rows) >= 5:
            append_jsonl(args.out_jsonl, new_rows)
            new_rows = []

        if idx % 10 == 0:
            print(f"[progress] {idx}/{len(target_samples)}", flush=True)

    if new_rows:
        append_jsonl(args.out_jsonl, new_rows)

    all_rows = {}
    if Path(args.out_jsonl).exists():
        for r in read_jsonl(args.out_jsonl):
            all_rows[r["sample_id"]] = r

    n = len(by_sample)
    current_correct = 0
    aug_any_correct = 0
    aug_weighted_correct = 0
    aug_judge_correct = 0

    fixed_by_extra_any = 0
    fixed_by_aug_weighted = 0
    fixed_by_aug_judge = 0
    broken_by_aug_weighted = 0
    broken_by_aug_judge = 0

    for sid, orig_cands in by_sample.items():
        orig_cands = sorted(orig_cands, key=lambda x: traj_order(x["tid"]))
        gold = orig_cands[0]["gold"]

        orig_weighted_ans, _, _, _ = weighted_vote(orig_cands)

        if sid in current_judge_by_sid:
            cur_ans = norm_num(current_judge_by_sid[sid].get("final_answer", ""))
        else:
            cur_ans = orig_weighted_ans

        cur_ok = int(is_correct_prediction(cur_ans, gold, answer_mode=answer_mode))
        current_correct += cur_ok

        if sid in all_rows:
            r = all_rows[sid]
            any_ok = int(r["aug_any_ok"])
            w_ok = int(r["aug_weighted_ok"])
            j_ok = int(r["judge_ok"]) if args.use_judge else w_ok
        else:
            any_ok = int(any(c["ok"] for c in orig_cands))
            w_ok = int(is_correct_prediction(orig_weighted_ans, gold, answer_mode=answer_mode))
            j_ok = w_ok

        aug_any_correct += any_ok
        aug_weighted_correct += w_ok
        aug_judge_correct += j_ok

        fixed_by_extra_any += int(cur_ok == 0 and any_ok == 1)
        fixed_by_aug_weighted += int(cur_ok == 0 and w_ok == 1)
        fixed_by_aug_judge += int(cur_ok == 0 and j_ok == 1)
        broken_by_aug_weighted += int(cur_ok == 1 and w_ok == 0)
        broken_by_aug_judge += int(cur_ok == 1 and j_ok == 0)

    summary = {
        "dataset": args.dataset,
        "trigger": args.trigger,
        "margin_threshold": args.margin_threshold,
        "n_samples": n,
        "target_samples": len(target_samples),
        "completed_samples": len(all_rows),
        "n_extra": args.n_extra,
        "use_judge": int(args.use_judge),
        "extra_weight_mode": args.extra_weight_mode,
        "extra_weight": args.extra_weight,
        "current_best_acc": current_correct / n,
        "aug_any_acc": aug_any_correct / n,
        "aug_weighted_acc": aug_weighted_correct / n,
        "aug_judge_acc": aug_judge_correct / n,
        "fixed_by_extra_any": fixed_by_extra_any,
        "fixed_by_aug_weighted": fixed_by_aug_weighted,
        "fixed_by_aug_judge": fixed_by_aug_judge,
        "broken_by_aug_weighted": broken_by_aug_weighted,
        "broken_by_aug_judge": broken_by_aug_judge,
        "net_aug_weighted": fixed_by_aug_weighted - broken_by_aug_weighted,
        "net_aug_judge": fixed_by_aug_judge - broken_by_aug_judge,
        "out_jsonl": args.out_jsonl,
    }

    write_json(args.out_json, summary)
    print(json.dumps(summary, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
